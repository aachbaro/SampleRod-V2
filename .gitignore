# Ignorer l'environnement virtuel
venv/

# Ignorer les fichiers compiles Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignorer les fichiers de logs et temporaires
*.log
*.tmp

# Ignorer les artefacts de build
dist/
build/
*.egg-info/
*.spec
*.nupkg

# Ignorer les fichiers specifiques a l'IDE
.vscode/
.idea/
*.iml

# Ignorer les fichiers systeme
.DS_Store
Thumbs.db

# Ignorer les fichiers generes par PyQt
*.qrc
*.ui

# Ignorer les fichiers de cache de l'application
.cache/
sample.db
logs/

# Frontend React (remote UI)
frontend/remote_ui/node_modules/
frontend/remote_ui/dist/
frontend/remote_ui/.env
frontend/remote_ui/.env.local

# Squirrel / packaging tools & outputs
tools/
Releases/

# Logs npm/yarn/pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Site marchand: tracker le code, ignorer secrets et data runtime
site/.env
site/.env.prod
site/data/
site/staticfiles/
site/releases-dev/

# Backups README temporaires
README.md.bak.*

# Données utilisateur drum detector (local seulement)
.drum_detector_saved_patterns.json
.drum_detector_user_motifs.json
