# ---- Django ----
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM
DJANGO_ALLOWED_HOSTS=samplerod.pascuans.dev,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://samplerod.pascuans.dev
DJANGO_DB_PATH=/app/data/samplerod-site.sqlite3

SITE_URL=https://samplerod.pascuans.dev

# ---- OIDC (auth.pascuans.dev) ----
OIDC_ISSUER=https://auth.pascuans.dev
OIDC_CLIENT_ID=samplerod-web
OIDC_CLIENT_SECRET=REPLACE_WITH_SECRET_FROM_CREATE_OAUTH_APPS
OIDC_REDIRECT_URI=https://samplerod.pascuans.dev/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://samplerod.pascuans.dev/
OIDC_SCOPES=openid profile email

# ---- Stripe (live keys) ----
STRIPE_PUBLIC_KEY=pk_live_REPLACE
STRIPE_SECRET_KEY=sk_live_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
STRIPE_PRICE_ID=price_REPLACE
STRIPE_LIVE=1

# ---- Releases ----
RELEASES_DIR=/srv/releases
SAMPLEROD_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM

# ---- Cloudflare tunnel (only needed when started with --with-tunnel) ----
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_TUNNEL_TOKEN

# ---- Gunicorn ----
GUNICORN_WORKERS=3
GUNICORN_LOG_LEVEL=info
SAMPLEROD_SITE_PORT=8003
