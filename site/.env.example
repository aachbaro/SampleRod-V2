# ---- Django ----
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8003,http://localhost:8003
DJANGO_DB_PATH=/app/data/samplerod-site.sqlite3

SITE_URL=http://127.0.0.1:8003

# ---- OIDC (auth.pascuans.dev / auth-server local) ----
OIDC_ISSUER=http://127.0.0.1:8001
OIDC_CLIENT_ID=samplerod-web
OIDC_CLIENT_SECRET=change-me-client-secret-from-create-oauth-apps
OIDC_REDIRECT_URI=http://127.0.0.1:8003/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:8003/
OIDC_SCOPES=openid profile email

# ---- Stripe (test keys for dev) ----
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_LIVE=0

# ---- Releases ----
RELEASES_DIR=/app/releases-dev
SAMPLEROD_ADMIN_TOKEN=dev-admin-token-change-me

# ---- Gunicorn ----
GUNICORN_WORKERS=3
GUNICORN_LOG_LEVEL=info
